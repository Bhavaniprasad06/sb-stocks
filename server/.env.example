# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/sbstocks

# JWT secret for signing tokens (change in production!)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Default virtual cash given to new users
DEFAULT_CASH=100000

# CORS origin for the React frontend
CLIENT_URL=http://localhost:5174

# Admin bootstrap account (created on server start if missing)
ADMIN_EMAIL=admin@sbstocks.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=SB Stocks Admin
